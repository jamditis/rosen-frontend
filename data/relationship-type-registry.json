{
  "schemaVersion": "1.0.0",
  "description": "Machine-readable relationship-type registry for the Jay Rosen Internet Archive knowledge graph. Formalizes allowed endpoint entity types, direction, inverse relationships, self-link and multi-assertion policy, temporal scope, and disputed-assertion support for every relationship type present in data/extracted_relationships.csv or in backend/entity_extraction_schema_v3.json. See data/README.md and scripts/validate-graph-data.mjs for how this is enforced, and issue #737 for the audit that produced it.",
  "entityTypes": [
    "Concept",
    "Event",
    "Location",
    "Organization",
    "Person",
    "Work"
  ],
  "evidenceStandards": {
    "pipeline-default": "Extracted from source record text by the entity-extraction pipeline (backend/entity_extraction_schema_v3.json), carrying a context snippet and a 0-1 confidence_score. The archive graph accepts assertions at any confidence today (no minimum threshold); acceptance is gated by referential integrity (extracted_entities.csv), the accepted/held relationship-type split (data/graph-validation-holds.json), and this registry's endpoint-type constraints."
  },
  "migrationNotes": [
    {
      "version": "1.0.0",
      "date": "2026-08-27",
      "summary": "Initial registry (issue #737). Endpoint-type constraints for accepted types are inferred from current usage in extracted_relationships.csv (falling back to backend/entity_extraction_schema_v3.json's valid_source_types/valid_target_types for the five types with zero current usage: Authored By, Quoted, Interviewed, Responds To, Founded). Legacy ambiguous types (Founded By, Owned By, Created, Covers) and the not-yet-wired Influenced type are marked status: \"deferred\" rather than guessed; their direction, inverse, symmetry, and temporal scope are curator decisions, not automation output."
    }
  ],
