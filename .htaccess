# Jay Rosen's Internet Archive - Apache Configuration

# Redirect the FAQ to its new top-level location (moved from /dissertation/faq/ in #567).
# The FAQ now covers the whole archive, not just the dissertation, so it no longer
# belongs under dissertation/. The (.*/)? prefix matches whichever mount this file
# sees (the public /j/rosen-archive/ path or the /wp-content/ disk path), and a 301
# lets browsers reattach the original #hash so existing permalinks keep working.
<IfModule mod_alias.c>
    RedirectMatch 301 ^(.*/)?dissertation/faq/?(index\.html)?$ https://pressthink.org/j/rosen-archive/faq/
</IfModule>

# Give ?record= deep links record-specific metadata before the React app runs.
# The internal rewrite keeps the public query-string URL unchanged, so the SPA
# still opens the selected record. A second pass serves the normal archive shell
# for an unknown id instead of turning a malformed share link into a 404.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{QUERY_STRING} (^|&)record=([A-Za-z0-9-]+)(&|$) [NC]
    RewriteRule ^(?:index\.html)?$ r/%2.html [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^r/[A-Za-z0-9-]+\.html$ index.html [END,QSD]
</IfModule>

# Enable gzip compression for faster data transfer

<IfModule mod_deflate.c>
    # Compress JSON data files (biggest impact - 25MB -> ~4MB)
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml

    # Handle .json files explicitly
    <FilesMatch "\.(json)$">
        SetOutputFilter DEFLATE
    </FilesMatch>
</IfModule>

# Enable browser caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On

    # Data files - cache for 1 hour (matches JS cache TTL)
    ExpiresByType application/json "access plus 1 hour"

    # Static assets - cache for 1 week
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts - cache for 1 month
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
    ExpiresByType application/font-woff2 "access plus 1 month"
    ExpiresByType application/font-woff "access plus 1 month"
</IfModule>

# Service-worker scripts must be revalidated on every update check. This
# applies to both the stable root bridge and frontend/sw.js.
<FilesMatch "^sw\.js$">
    <IfModule mod_expires.c>
        ExpiresActive Off
    </IfModule>
    <IfModule mod_headers.c>
        Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
        Header always set Expires "0"
    </IfModule>
</FilesMatch>

# Set proper MIME types
<IfModule mod_mime.c>
    AddType application/json .json
    AddType application/javascript .js
    AddType text/css .css
</IfModule>

# Security headers
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"

    # Clickjacking protection
    Header set X-Frame-Options "SAMEORIGIN"

    # Referrer leakage control
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Block unused browser capabilities by default
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    # Content Security Policy. Validated in-browser across every deployed route +
    # standalone tool under this exact header (React mount, MiniSearch, sql.js,
    # dataviz, privacy-enhanced YouTube embed) with zero violations before shipping.
    # script-src:
    #   'unsafe-inline'      -- the zero-build app runs inline scripts site-wide:
    #                           index.html's <script type="importmap"> plus small inline
    #                           config/console blocks on index.html and the
    #                           dissertation/faq/tools pages.
    #   'wasm-unsafe-eval'   -- sql.js compiles its self-hosted WebAssembly binary.
    #   esm.sh               -- React/HTM/Lucide/MiniSearch CDN per the import map.
    #   cdnjs.cloudflare.com -- SRI-pinned sql.js loader (sqliteService.js), plus
    #                           noUiSlider (dataviz).
    #   cdn.jsdelivr.net     -- chart.js + treemap plugin (dataviz).
    # style-src cdnjs.cloudflare.com -- noUiSlider stylesheet (dataviz).
    # connect-src script.google.com  -- the branded report/submission endpoint (#509 fetch).
    # frame-src www.youtube-nocookie.com -- Privacy-enhanced YouTube embeds.
    # frame-src www.youtube.com -- Temporary cache-rollover compatibility for
    #                           returning visitors whose 3.8.15 service worker
    #                           still serves the former embed URL on first load.
    # img-src images.unsplash.com -- featured-work photos (FeaturedSection, constants.js).
    # img-src journalism.nyu.edu  -- the dissertation bio photo.
    # img-src pressthink.org      -- images the pages reference by absolute URL (e.g. the
    #                           dissertation portrait). This equals 'self' in production
    #                           (the archive is served from pressthink.org), but is listed
    #                           explicitly so the images do not depend on the serving
    #                           origin staying identical (a preview origin or the
    #                           archive.pressthink.org subdomain would otherwise break them).
    #                           Inline paper-texture SVGs are data:. Kept to these hosts,
    #                           not scheme-wide https:, because no deployed page loads an
    #                           image from a data-controlled URL (archive records carry no
    #                           external image hosts), so a wider allowance only opens an
    #                           arbitrary-origin beacon path with no deployed benefit.
    # Verify HSTS at the Cloudflare/host layer before adding here (avoid duplicate header).
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://esm.sh https://cdnjs.cloudflare.com https://cdn.jsdelivr.net 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://esm.sh https://script.google.com; frame-src https://www.youtube-nocookie.com https://www.youtube.com; img-src 'self' data: https://images.unsplash.com https://journalism.nyu.edu https://pressthink.org; object-src 'none'; base-uri 'self'; form-action 'self'"

    # Add cache control headers for data files
    <FilesMatch "\.(json)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>
