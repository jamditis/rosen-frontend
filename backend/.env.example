# Jay Rosen Digital Archive - Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# Google Sheets Configuration
# The name of your Google Sheet containing the archive URL list
SPREADSHEET_NAME="your_spreadsheet_name"

# Google Gemini AI API Key
# Used for content analysis, categorization, and summarization
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key"

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Google Cloud Credentials File Path
# Path to your Google Cloud service account credentials JSON file
# Default: google_credentials.json (in the backend directory)
# Uncomment to override the default:
# GOOGLE_APPLICATION_CREDENTIALS="google_credentials.json"

# Row Range Configuration for workflow.py
# Controls which rows from the Google Sheet are processed during execution
# Useful for testing specific ranges or processing data in batches

# PROCESS_START_ROW: Starting row index (0-based, inclusive)
# Default: 0 (start from the first row)
# Example: 609 (start from row 609)
PROCESS_START_ROW=0

# PROCESS_END_ROW: Ending row index (0-based, exclusive)
# Default: -1 (process all rows to the end)
# Example: 619 (stop before row 619, so rows 609-618 are processed)
# Note: Python slice notation is exclusive of the end index
#       So [609:619] processes rows at indices 609, 610, ..., 618 (10 rows total)
# Note: Use -1 to process all remaining rows from START_ROW
PROCESS_END_ROW=-1

# Examples:
# Process all rows: PROCESS_START_ROW=0, PROCESS_END_ROW=-1
# Process rows 609-618: PROCESS_START_ROW=609, PROCESS_END_ROW=619
# Process first 100 rows: PROCESS_START_ROW=0, PROCESS_END_ROW=100
# Process from row 500 to end: PROCESS_START_ROW=500, PROCESS_END_ROW=-1

# ============================================================================
# NOTES
# ============================================================================
# - Place your google_credentials.json file in the backend/ directory
# - Never commit your .env file or credentials to version control
# - See backend/README.md for detailed setup instructions
