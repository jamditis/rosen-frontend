# Jay Rosen Digital Archive - Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# Google Sheets Configuration
# The name of your Google Sheet containing the archive URL list
SPREADSHEET_NAME="your_spreadsheet_name"

# Google Gemini AI API Key
# Used for content analysis, categorization, and summarization
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key"

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Google Cloud Credentials File Path
# Path to your Google Cloud service account credentials JSON file
# Default: google_credentials.json (in the backend directory)
# Uncomment to override the default:
# GOOGLE_APPLICATION_CREDENTIALS="google_credentials.json"

# ============================================================================
# NOTES
# ============================================================================
# - Place your google_credentials.json file in the backend/ directory
# - Never commit your .env file or credentials to version control
# - See backend/README.md for detailed setup instructions
