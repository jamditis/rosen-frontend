[Unit]
Description=Rosen Archive submission server (Pillar 3 authoring workflow)
Documentation=https://github.com/jamditis/rosen-frontend/blob/main/docs/plans/2026-05-24-pillar3-authoring-workflow-design.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jamditis
Group=jamditis
WorkingDirectory=/home/jamditis/projects/rosen-frontend/backend
EnvironmentFile=/etc/rosen-submission.env
# Wrapper resolves the Poetry venv path at start time, so the unit keeps
# working after env recreation / Python upgrade. Install to
# /usr/local/sbin/rosen-submission-exec — see automation/SETUP.md.
ExecStart=/usr/local/sbin/rosen-submission-exec
Restart=on-failure
RestartSec=5
# Submission server only listens on loopback; Cloudflare tunnel fronts it.
# Hardening: no privilege escalation, read-only system view, private /tmp.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/jamditis/projects/rosen-frontend/data
ReadWritePaths=/home/jamditis/projects/rosen-frontend/backend/submission_server
ReadWritePaths=/home/jamditis/projects/rosen-frontend/ftp-upload

[Install]
WantedBy=multi-user.target
