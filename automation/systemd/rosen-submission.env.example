# Environment file for rosen-submission.service.
#
# Install on houseofjawn:
#   sudo install -m 600 -o root -g jamditis \
#     automation/systemd/rosen-submission.env.example /etc/rosen-submission.env
#   sudo $EDITOR /etc/rosen-submission.env   # fill in the placeholders below
#
# Mode 0640 (or 0600) keeps creds out of any other user's view. Never check
# the filled-in copy into git.

# Bind host (loopback only — Cloudflare tunnel fronts this).
SUBMISSION_HOST=127.0.0.1
SUBMISSION_PORT=8084

# Shared secret. Must match the Apps Script's SUBMISSION_TOKEN script property.
# Generate with: openssl rand -hex 32
SUBMISSION_AUTH_TOKEN=

# SFTP push to pressthink.org. Get creds from pass: claude/rosen/wp-admin.
ROSEN_SFTP_HOST=
ROSEN_SFTP_PORT=22
ROSEN_SFTP_USER=
ROSEN_SFTP_PASSWORD=
# Or use key auth (preferred): point at a 0600 keyfile under /home/jamditis.
# ROSEN_SFTP_KEY_PATH=/home/jamditis/.ssh/rosen_deploy
# ROSEN_SFTP_KEY_PASSPHRASE=
ROSEN_SFTP_REMOTE_PATH=

# Sheets writeback. Service account JSON from pass: claude/rosen/rosen-service-account-full.
# Use either ROSEN_SHEETS_SA_KEY (path to JSON file) OR ROSEN_SHEETS_SA_KEY_JSON (inline JSON).
ROSEN_SHEETS_SA_KEY=/etc/rosen-sa.json
# ROSEN_SHEETS_SA_KEY_JSON=
