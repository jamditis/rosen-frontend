{
  "name": "jay-rosen-digital-archive",
  "version": "1.0.0",
  "description": "Interactive frontend for Jay Rosen's journalism scholarship archive",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:data": "node --test tests/data-integrity.test.js tests/csv-quality.test.js",
    "test:pipeline": "node --test tests/data-pipeline.test.js tests/thread-detection.test.js tests/process-record.test.js tests/thread-algorithm.test.js",
    "test:frontend": "node --test tests/version-consistency.test.js tests/frontend-structure.test.js",
    "export-data": "node data/export-archive-data.js",
    "build:css": "tailwindcss -i src/tailwind.css -o dist/tailwind.css --minify",
    "watch:css": "tailwindcss -i src/tailwind.css -o dist/tailwind.css --watch"
  },
  "devDependencies": {
    "csv-parse": "^5.6.0",
    "tailwindcss": "^3.4.18"
  },
  "dependencies": {
    "csv-stringify": "^6.6.0"
  }
}
