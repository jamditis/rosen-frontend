{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pressthink.org/j/rosen-archive/schemas/preservation-manifest-v1.json",
  "title": "Rosen archive preservation manifest",
  "description": "Versioned sidecar metadata for source checks, captures, artifacts, storage copies, fixity, rights, and review events.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "vocabularyVersion",
    "manifestId",
    "createdAt",
    "objects",
    "events",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "vocabularyVersion": {
      "const": "1.0.0"
    },
    "manifestId": {
      "$ref": "#/$defs/manifestId"
    },
    "supersedesManifestId": {
      "$ref": "#/$defs/manifestId"
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/archiveObject"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preservationEvent"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "webUrl": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "artifactUri": {
      "type": "string",
      "pattern": "^(?:https?|s3|gs|file|urn):[^\\s]+$"
    },
    "manifestId": {
      "type": "string",
      "pattern": "^urn:rosen-preservation:manifest:[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "objectId": {
      "type": "string",
      "pattern": "^urn:rosen:object:(?:archive-record|social-post|entity|relationship|dataset|source-file|generated-artifact|feature-record):[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^urn:rosen-preservation:event:[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^urn:rosen-preservation:artifact:[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "copyId": {
      "type": "string",
      "pattern": "^urn:rosen-preservation:copy:[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "archiveObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectId",
        "objectType",
        "canonicalSourceUrl"
      ],
      "properties": {
        "objectId": {
          "$ref": "#/$defs/objectId"
        },
        "objectType": {
          "enum": [
            "archive-record",
            "social-post",
            "entity",
            "relationship",
            "dataset",
            "source-file",
            "generated-artifact",
            "feature-record"
          ]
        },
        "canonicalSourceUrl": {
          "$ref": "#/$defs/webUrl"
        },
        "alternateSourceUrls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/webUrl"
          },
          "uniqueItems": true
        },
        "sourceRecordId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actorType",
        "actorId"
      ],
      "properties": {
        "actorType": {
          "enum": [
            "human",
            "automation"
          ]
        },
        "actorId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]*$"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "not-reviewed",
            "review-required",
            "accepted",
            "rejected",
            "superseded"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "retrievalClient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedUrl",
        "observedSourceUrl",
        "retrievedAt",
        "finalUrl",
        "httpStatus",
        "httpOutcome",
        "mediaType",
        "bytesReceived",
        "client",
        "semanticOutcome"
      ],
      "properties": {
        "requestedUrl": {
          "$ref": "#/$defs/webUrl"
        },
        "observedSourceUrl": {
          "$ref": "#/$defs/webUrl"
        },
        "retrievedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "finalUrl": {
          "$ref": "#/$defs/webUrl"
        },
        "httpStatus": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "httpOutcome": {
          "enum": [
            "response-received",
            "network-error",
            "timeout",
            "aborted",
            "not-requested"
          ]
        },
        "mediaType": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "bytesReceived": {
          "type": "integer",
          "minimum": 0
        },
        "reportedByteLength": {
          "type": "integer",
          "minimum": 0
        },
        "limitBytes": {
          "type": "integer",
          "minimum": 1
        },
        "client": {
          "$ref": "#/$defs/retrievalClient"
        },
        "semanticOutcome": {
          "enum": [
            "intended-content",
            "bot-wall",
            "login-wall",
            "missing",
            "redirect",
            "uncertain",
            "oversize-abort"
          ]
        },
        "redirectChain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/webUrl"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "semanticOutcome": {
                "const": "oversize-abort"
              }
            }
          },
          "then": {
            "required": [
              "reportedByteLength",
              "limitBytes"
            ]
          }
        }
      ]
    },
    "wayback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captureTimestamp",
        "replayUrl"
      ],
      "properties": {
        "captureTimestamp": {
          "type": "string",
          "pattern": "^[0-9]{14}$"
        },
        "replayUrl": {
          "type": "string",
          "pattern": "^https?://web\\.archive\\.org/web/[0-9]{14}(?:[a-z]{2}_)?/https?://[^\\s]+$"
        }
      }
    },
    "rightsDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rightsStatus",
        "accessDecision",
        "publicDepositEligibility",
        "policyVersion",
        "decisionBasis"
      ],
      "properties": {
        "rightsStatus": {
          "enum": [
            "cleared",
            "restricted",
            "hold",
            "unknown"
          ]
        },
        "accessDecision": {
          "enum": [
            "public",
            "restricted",
            "private",
            "embargoed"
          ]
        },
        "publicDepositEligibility": {
          "enum": [
            "eligible",
            "ineligible",
            "undetermined"
          ]
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1
        },
        "decisionBasis": {
          "type": "string",
          "minLength": 1
        },
        "embargoUntil": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "accessDecision": {
                "const": "embargoed"
              }
            },
            "required": [
              "accessDecision"
            ]
          },
          "then": {
            "required": [
              "embargoUntil"
            ]
          }
        }
      ]
    },
    "fixity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "algorithm",
        "expectedDigest",
        "observedDigest",
        "outcome"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/artifactId"
        },
        "algorithm": {
          "const": "sha256"
        },
        "expectedDigest": {
          "$ref": "#/$defs/sha256"
        },
        "observedDigest": {
          "$ref": "#/$defs/sha256"
        },
        "outcome": {
          "enum": [
            "match",
            "mismatch"
          ]
        }
      }
    },
    "normalizationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceLocator",
        "observations",
        "fieldMapping",
        "normalizedObjectSha256"
      ],
      "properties": {
        "sourceLocator": {
          "type": "string",
          "minLength": 1
        },
        "observations": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "fieldMapping": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "normalizedObjectSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "preservationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "eventType",
        "objectId",
        "taskVersion",
        "inputHash",
        "actor",
        "occurredAt",
        "review"
      ],
      "properties": {
        "eventId": {
          "$ref": "#/$defs/eventId"
        },
        "eventType": {
          "enum": [
            "source-check",
            "capture-attempt",
            "wayback-reference",
            "artifact-created",
            "storage-copy-created",
            "fixity-check",
            "rights-decision",
            "review-decision"
          ]
        },
        "objectId": {
          "$ref": "#/$defs/objectId"
        },
        "taskVersion": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:+-]*$"
        },
        "inputHash": {
          "$ref": "#/$defs/sha256"
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "occurredAt": {
          "$ref": "#/$defs/timestamp"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "supersedesEventId": {
          "$ref": "#/$defs/eventId"
        },
        "retrieval": {
          "$ref": "#/$defs/retrieval"
        },
        "wayback": {
          "$ref": "#/$defs/wayback"
        },
        "artifactId": {
          "$ref": "#/$defs/artifactId"
        },
        "storageCopyId": {
          "$ref": "#/$defs/copyId"
        },
        "fixity": {
          "$ref": "#/$defs/fixity"
        },
        "rights": {
          "$ref": "#/$defs/rightsDecision"
        },
        "normalizationEvidence": {
          "$ref": "#/$defs/normalizationEvidence"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "eventType": {
                "enum": [
                  "source-check",
                  "capture-attempt"
                ]
              }
            }
          },
          "then": {
            "required": [
              "retrieval"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "wayback-reference"
              }
            }
          },
          "then": {
            "required": [
              "wayback"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "artifact-created"
              }
            }
          },
          "then": {
            "required": [
              "artifactId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "storage-copy-created"
              }
            }
          },
          "then": {
            "required": [
              "artifactId",
              "storageCopyId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "fixity-check"
              }
            }
          },
          "then": {
            "required": [
              "fixity"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "rights-decision"
              }
            }
          },
          "then": {
            "required": [
              "rights"
            ]
          }
        }
      ]
    },
    "storageCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copyId",
        "uri",
        "storageClass",
        "access",
        "createdAt"
      ],
      "properties": {
        "copyId": {
          "$ref": "#/$defs/copyId"
        },
        "uri": {
          "$ref": "#/$defs/artifactUri"
        },
        "storageClass": {
          "enum": [
            "working",
            "preservation",
            "replica",
            "public-deposit"
          ]
        },
        "access": {
          "enum": [
            "public",
            "restricted",
            "private",
            "embargoed"
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "objectId",
        "captureEventId",
        "artifactType",
        "uri",
        "sha256",
        "byteSize",
        "storageCopies"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/artifactId"
        },
        "objectId": {
          "$ref": "#/$defs/objectId"
        },
        "captureEventId": {
          "$ref": "#/$defs/eventId"
        },
        "artifactType": {
          "enum": [
            "http-response",
            "warc",
            "wacz",
            "screenshot",
            "pdf",
            "transcript",
            "metadata",
            "checksum-manifest",
            "other"
          ]
        },
        "uri": {
          "$ref": "#/$defs/artifactUri"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 0
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "storageCopies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/storageCopy"
          }
        }
      }
    }
  }
}
