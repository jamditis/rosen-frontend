<section class="article__title">
        <h1>Salon Radio:  Anthrax edition</h1>
    <h2>Two experts -- one in bioweapons and one in journalism -- explore the numerous, still unanswered questions in the anthrax case.</h2>
    <div class="writers">
                    <div>
                <div class="by">
                    <span>By</span>
                                            <a href="https://www.salon.com/writer/glenn_greenwald">
                            Glenn Greenwald                        </a>
                                                            </div>
                                    <div>
                                            </div>
                            </div>
                <div class="date">
                            <h3>
                    <span>Published</span>
                    <time datetime="2008-08-08T12:54:00-04:00">
                        August 8, 2008 12:54PM (EDT)                    </time>
                </h3>
                    </div>
    </div>
</section>
