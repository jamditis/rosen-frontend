		<style>


.bb-type-quicklink {
    --bb-color:            #DAB08E;  
    --bb-hover-color:      #aaaaaa;
    --bb-bg:               rgba(253, 230, 194, 0.50); 
    --bb-border-color:     #DAB08E; 
    --bb-shadow:           rgba(0,0,0,0.35) 0px 0px 10px 0px; 
    --bb-hot-color:        #aa0000;  
    --bb-vhot-color:       #ff0000;  
    --bb-hot-shadow:       0 0 10px 0 rgba(170,0,0,0.5); 
    --bb-vhot-shadow:      0 0 10px 0 rgba(255,0,0,0.5); 
    --bb-heat-border-width: 2px;     
    --bb-text-color:       #5F3513;  
    --bb-link-color:       #aa0000; 
    --bb-link-hover-color: #ff0000; 
    --bb-font:             'Special Elite', monospace; 
    
    
    --bb-font-size:        95%;
    --bb-font-weight:      normal;
    --bb-text-align:       left;  
    --bb-line-height:      1.4;
    --bb-pad-y:            4px;  
    --bb-text-margin-y:    .5em;    
    
    --bb-tip-bg:           #5F3513; 
    --bb-tip-color:        rgba(253, 230, 194, 1); 

    --bb-list-indent:      1em; 
    --bb-list-gap:         0.3em; 
    --bb-bullet-scale:     1.5; 

    --bb-alley:            12px;      
    --bb-bolt-color:       #DAB08E;   
    --bb-bolt-hover-color: #5F3513;   

    --bb-bsky-max-width:    400px; 
    --bb-twitter-max-width: 400px; 
    --bb-video-max-width:   480px; 
}




.bb-main-loop .bb-type-quicklink h3.elementor-heading-title,
.bb-main-loop .bb-type-quicklink .elementor-widget-theme-post-title,
.bb-main-loop .bb-type-quicklink .post-sub-sub-title,
.bb-main-loop .bb-type-quicklink .bb25-archive-post-info,
.bb-main-loop .bb-type-quicklink .bb-comment-count,
.bb-main-loop .bb-type-quicklink .bb-archive-loop-photo {
    display: none !important;
}


.bb-main-loop .bb-type-quicklink .e-con.e-child:has(.bb-archive-loop-photo) {
    display: none !important;
}
.bb-main-loop .bb-type-quicklink .e-con.e-child:has(.bb-archive-loop-photo) + .e-con {
    width: 100% !important;
}
.bb-main-loop .bb-type-quicklink .e-con.e-child:has(.bb-archive-loop-photo) + .e-con .elementor-heading-title {
    text-align: var(--bb-text-align) !important;
}
.bb-main-loop .bb-type-quicklink .e-con.e-child:has(.bb-archive-loop-photo) + .e-con .elementor-align-center .elementor-icon-list-items {
    justify-content: flex-end !important;
}


.bb-main-loop .bb-type-quicklink .bb25-archive-posts-loop-items:not(.bb-sticky-post) {
    background: var(--bb-bg) !important;
    border: 1px solid var(--bb-border-color) !important;
    border-left: 4px solid var(--bb-color) !important;
    box-shadow: var(--bb-shadow) !important;
}


.bb-main-loop .bb-type-quicklink.bb-heat-hot .bb25-archive-posts-loop-items:not(.bb-sticky-post),
body.bb-heat-hot .bb-main-loop .bb-type-quicklink .bb25-archive-posts-loop-items:not(.bb-sticky-post) {
    border: var(--bb-heat-border-width) solid var(--bb-hot-color) !important;
    border-left: 4px solid var(--bb-hot-color) !important;
    box-shadow: var(--bb-hot-shadow) !important;
}
.bb-main-loop .bb-type-quicklink.bb-heat-very_hot .bb25-archive-posts-loop-items:not(.bb-sticky-post),
body.bb-heat-very_hot .bb-main-loop .bb-type-quicklink .bb25-archive-posts-loop-items:not(.bb-sticky-post) {
    border: var(--bb-heat-border-width) solid var(--bb-vhot-color) !important;
    border-left: 4px solid var(--bb-vhot-color) !important;
    box-shadow: var(--bb-vhot-shadow) !important;
}

.bb-type-quicklink.bb-heat-hot,
body.bb-heat-hot .bb-type-quicklink {
    --bb-bolt-color: var(--bb-hot-color);
}
.bb-type-quicklink.bb-heat-very_hot,
body.bb-heat-very_hot .bb-type-quicklink {
    --bb-bolt-color: var(--bb-vhot-color);
}


.bb-main-loop .bb-type-quicklink .bb25-archive-posts-loop-items.bb-sticky-post {
    background: var(--bb-bg) !important;
}

.bb-main-loop .bb-type-quicklink .bb25-archive-posts-loop-items.bb-sticky-post {
    border: 1px solid var(--bb-border-color) !important;
    border-left: 4px solid var(--bb-color) !important;
}

.bb-main-loop .bb-type-quicklink.bb-heat-hot .bb25-archive-posts-loop-items.bb-sticky-post,
body.bb-heat-hot .bb-main-loop .bb-type-quicklink .bb25-archive-posts-loop-items.bb-sticky-post {
    border: var(--bb-heat-border-width) solid var(--bb-hot-color) !important;
    border-left: 4px solid var(--bb-hot-color) !important;
}
.bb-main-loop .bb-type-quicklink.bb-heat-very_hot .bb25-archive-posts-loop-items.bb-sticky-post,
body.bb-heat-very_hot .bb-main-loop .bb-type-quicklink .bb25-archive-posts-loop-items.bb-sticky-post {
    border: var(--bb-heat-border-width) solid var(--bb-vhot-color) !important;
    border-left: 4px solid var(--bb-vhot-color) !important;
}

.bb-main-loop .bb-type-quicklink.bb-heat-hot .bb25-archive-posts-loop-items.bb-sticky-post:hover,
body.bb-heat-hot .bb-main-loop .bb-type-quicklink .bb25-archive-posts-loop-items.bb-sticky-post:hover {
    box-shadow: var(--bb-hot-shadow) !important;
}
.bb-main-loop .bb-type-quicklink.bb-heat-very_hot .bb25-archive-posts-loop-items.bb-sticky-post:hover,
body.bb-heat-very_hot .bb-main-loop .bb-type-quicklink .bb25-archive-posts-loop-items.bb-sticky-post:hover {
    box-shadow: var(--bb-vhot-shadow) !important;
}

.bb-main-loop .bb-type-quicklink .bb-pinned-badge {
    right: calc(var(--bb-alley) + 6px) !important;
}


.bb-main-loop .bb-type-quicklink .post-sub-title,
.bb-main-loop .bb-type-quicklink .post-sub-title .elementor-heading-title {
    color: var(--bb-text-color) !important;
    font-family: var(--bb-font) !important;
    font-size: var(--bb-font-size) !important;
    font-weight: var(--bb-font-weight) !important;
    line-height: var(--bb-line-height) !important;
}


.bb-main-loop .bb-type-quicklink .post-sub-title a,
.bb-main-loop .bb-type-quicklink .post-sub-title .elementor-heading-title a {
    color: var(--bb-link-color) !important;
    text-decoration: none !important;
}
.bb-main-loop .bb-type-quicklink .post-sub-title a:hover,
.bb-main-loop .bb-type-quicklink .post-sub-title .elementor-heading-title a:hover {
    color: var(--bb-link-hover-color) !important;
    text-decoration: underline !important;
}


.bb-main-loop .bb-type-quicklink .post-sub-title {
    padding-left: var(--bb-alley) !important;
    padding-right: var(--bb-alley) !important;
    box-sizing: border-box !important;
}


.bb-main-loop .bb-type-quicklink .post-sub-title ul.bb-ql-list { list-style: none !important; margin: var(--bb-text-margin-y) 0 0 0 !important;  padding: 0 !important; text-align: left !important; }
.bb-main-loop .bb-type-quicklink .post-sub-title ul.bb-ql-list li { position: relative !important; margin: 0 0 var(--bb-list-gap) 0 !important; padding: 0 0 0 var(--bb-list-indent) !important; }
.bb-main-loop .bb-type-quicklink .post-sub-title ul.bb-ql-list li:last-child { margin-bottom: 0 !important; }
.bb-main-loop .bb-type-quicklink .post-sub-title ul.bb-ql-list li::before { content: "\2022"; position: absolute; left: 0; top: 0; line-height: inherit; transform: scale(var(--bb-bullet-scale)); transform-origin: left center; }


.bb-main-loop .bb-type-quicklink .bb25-archive-posts-loop-items .e-con .post-sub-title,
.bb-main-loop .bb-type-quicklink .bb25-archive-posts-loop-items .e-con .post-sub-title .elementor-heading-title {
    text-align: var(--bb-text-align) !important;
}


.bb-main-loop .bb-type-quicklink .post-sub-title center,
.bb-main-loop .bb-type-quicklink .post-sub-title .c {
    display: block !important;
    text-align: center !important;
}


.bb-main-loop .bb-type-quicklink .bb25-archive-posts-loop-items {
    padding-top: var(--bb-pad-y) !important;
    padding-bottom: var(--bb-pad-y) !important;
}
.bb-main-loop .bb-type-quicklink .post-sub-title p {
    margin-top: var(--bb-text-margin-y) !important;
    margin-bottom: var(--bb-text-margin-y) !important;
}


.bb-main-loop .bb-type-quicklink .post-sub-title .bb-image-wrap {
    margin-bottom: 0 !important;
}
.bb-main-loop .bb-type-quicklink .post-sub-title .bb-image-wrap > div:empty {
    display: none !important;   
}


.bb-main-loop .bb-type-quicklink .post-sub-title,
.bb-main-loop .bb-type-quicklink .post-sub-title .elementor-heading-title {
    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
}
.bb-main-loop .bb-type-quicklink .post-sub-title p:last-child {
    margin-bottom: 0 !important;
}


.bb-main-loop .bb-type-quicklink .bb25-archive-posts-loop-items {
    position: relative !important;
}
.bb-main-loop .bb-type-quicklink .bb-ql-bolt {
    position: absolute;
    top: 5px;                     
    right: 4px;                   
    width: 10px;                  
    height: 22px;
    padding: 0;
    margin: 0;
    border: 0;
    background: none;
    color: var(--bb-bolt-color);
    cursor: pointer;
    line-height: 0;
    z-index: 6;
    -webkit-tap-highlight-color: transparent;
}
.bb-main-loop .bb-type-quicklink .bb-ql-bolt svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
    display: block;
}
.bb-main-loop .bb-type-quicklink .bb-ql-bolt:hover,
.bb-main-loop .bb-type-quicklink .bb-ql-bolt:focus-visible,
.bb-main-loop .bb-type-quicklink .bb-ql-bolt.bb-tip-open {
    color: var(--bb-bolt-hover-color);
    z-index: 20;   
}

.bb-main-loop .bb-type-quicklink .bb-ql-bolt .bb-ql-tip {
    position: absolute;
    top: 28px;
    right: 0;
    display: block;
    width: 240px;                 
    white-space: normal;
    box-sizing: border-box;
    padding: 6px 10px;
    background: var(--bb-tip-bg);
    color: var(--bb-tip-color);
    font: normal 13px/1.3 sans-serif;
    text-align: left;
    border-radius: 4px;
    opacity: 0;
    visibility: hidden;
    transition: opacity .2s ease;
    pointer-events: none;
}
.bb-main-loop .bb-type-quicklink .bb-ql-bolt .bb-ql-tip i {
    font-style: italic;
}
.bb-main-loop .bb-type-quicklink .bb-ql-bolt:hover .bb-ql-tip,
.bb-main-loop .bb-type-quicklink .bb-ql-bolt.bb-tip-open .bb-ql-tip {
    opacity: 1;
    visibility: visible;
}


.bb-main-loop .bb-type-quicklink .bb25-archive-posts-loop-items {
    position: relative !important;
}

.bb-main-loop .bb-type-quicklink .bb25-archive-posts-loop-items .e-con:has(.post-edit-link):not(:has(> .elementor-widget-shortcode .post-edit-link)) {
    position: static !important;
}
.bb-main-loop .bb-type-quicklink .e-con:has(> .elementor-widget-shortcode .post-edit-link) {
    position: absolute !important;
    right: -18px !important;
    bottom: -5px !important;          
    top: auto !important;
    transform: none !important;
    width: auto !important;
    min-height: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    z-index: 2;
}
.bb-main-loop .bb-type-quicklink .post-edit-link span {
    font-size: 0 !important;           
}
.bb-main-loop .bb-type-quicklink .post-edit-link i {
    font-size: 14px !important;        
}


body.single .bb-main-loop .bb-type-quicklink .e-con:has(> .elementor-widget-shortcode .post-edit-link) {
    right: 2px !important;    
}


.bb-main-loop .bb-type-quicklink iframe.bluesky-embed,
.bb-main-loop .bb-type-quicklink .bluesky-embed {
    max-width: var(--bb-bsky-max-width) !important;
    margin-left: auto !important;
    margin-right: auto !important;
}
.bb-main-loop .bb-type-quicklink .twitter-tweet,
.bb-main-loop .bb-type-quicklink iframe[id^="twitter-widget"] {
    max-width: var(--bb-twitter-max-width) !important;
    margin-left: auto !important;
    margin-right: auto !important;
}

</style>
    <style>
    @media (max-width: 600px) {
        .bb-image-wrap.bb-image-left,
        .bb-image-wrap.bb-image-right,
        .bb-image-wrap.bb-image-center {
            float: none !important;
