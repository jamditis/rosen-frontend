        .bb-player-wrap {
            width: 100%;
            margin: 16px 0;
            box-sizing: border-box;
        }
        
        .bb-player-wrap ins.adsbygoogle,
        .bb-player-wrap .adsbygoogle,
        .bb-player-wrap iframe[id^="aswift_"],
        .bb-player-wrap iframe[src*="googlesyndication"],
        .bb-player-wrap iframe[src*="doubleclick"] {
            display: none !important;
            height: 0 !important;
            width: 0 !important;
        }
        
        .bb-player {
            width: 100%;
            padding: 16px;
            box-sizing: border-box;
            font-family: arial, sans-serif;
            border-radius: 8px 8px 0 0;
        }
        
        .bb-player-bradcast {
            background: #1F243F;
            color: #ffffff;
            border: 2px solid #e94560;
            border-bottom: none;
        }
        .bb-player-bradcast .bb-progress-fill {
            background: #e94560;
        }
        .bb-player-bradcast .bb-player-show {
            color: #e94560;
        }
        
        .bb-player-gnr {
            background: #1a3d1a;
            color: #ffffff;
            border: 2px solid #5ADA04;
            border-bottom: none;
        }
        .bb-player-gnr .bb-progress-fill {
            background: #5ADA04;
        }
        .bb-player-gnr .bb-progress-bar {
            background: rgba(255,255,255,0.15);
        }
        .bb-player-gnr .bb-player-show {
            color: #5ADA04;
        }
        
        .bb-player-generic {
            background: #000000;
            color: #ffffff;
            border: 2px solid #F5C774;
            border-bottom: none;
        }
        .bb-player-generic .bb-progress-fill {
            background: #F5C774;
        }
        .bb-player-generic .bb-progress-bar {
            background: rgba(255,255,255,0.15);
        }
        .bb-player-generic .bb-player-show {
            color: #F5C774;
        }
        
        .bb-player-inner {
            display: flex;
            flex-direction: row;
            gap: 20px;
            align-items: flex-start;
            width: 100%;
            box-sizing: border-box;
        }
        .bb-player-col1 {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
            width: 130px;
            text-align: center;
        }
        .bb-logo-link {
            display: block;
            line-height: 0;
            border: none !important;
            text-decoration: none !important;
        }
        .bb-logo-link:hover .bb-player-logo {
            opacity: 0.85;
        }
        .bb-player-logo {
            width: 80px;
            height: 80px;
            border-radius: 8px;
            object-fit: cover;
            transition: opacity 0.2s;
        }
        .bb-player-info {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }
        .bb-player-show {
            font-size: 0.8em;
            font-weight: bold;
            line-height: 1.2;
        }
        .bb-player-subtitle {
            font-size: 0.72em;
            opacity: 0.8;
            line-height: 1.2;
            color: #ffffff;
        }
        .bb-player-date {
            font-size: 0.72em;
            opacity: 0.7;
            line-height: 1.2;
            color: #ffffff;
        }
        .bb-download {
            font-size: 0.72em;
            margin-top: 4px;
            display: block;
            font-style: italic;
            color: inherit;
        }
        
        .bb-player-col2 {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        
        .bb-episode-title {
            font-size: 0.9em;
            line-height: 1.3;
            opacity: 0.9;
            overflow: hidden;
            white-space: nowrap;
            width: 100%;
        }
        .bb-episode-title-inner { display: inline-block; }
        .bb-title-main   { font-weight: bold; }
        .bb-title-sep    { font-weight: normal; opacity: 0.5; }
        .bb-title-sub    { font-weight: normal; font-style: italic; }
        .bb-title-subsub { font-weight: normal; font-style: normal; }
        @keyframes bb-scroll {
            0%   { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }
        
        .bb-player .bb-btn {
            all: unset !important;
            display: inline-flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            box-sizing: border-box !important;
            cursor: pointer !important;
            color: #ffffff !important;
            border: 2px solid #ffffff !important;
            background: transparent !important;
            outline: none !important;
            box-shadow: none !important;
            -webkit-appearance: none !important;
            appearance: none !important;
            gap: 3px !important;
        }
        .bb-player .bb-btn:hover,
        .bb-player .bb-btn:focus,
        .bb-player .bb-btn:active {
            opacity: 0.8 !important;
            background: transparent !important;
            outline: none !important;
            box-shadow: none !important;
        }
        .bb-player .bb-play {
            width: 60px !important;
            height: 60px !important;
            border-radius: 50% !important;
            font-size: 1.4em !important;
        }
        .bb-player .bb-skip {
            width: 54px !important;
            height: 54px !important;
            border-radius: 10px !important;
            font-size: 1.2em !important;
        }
        .bb-btn-label {
            font-size: 0.5em;
            font-weight: normal;
            font-family: arial, sans-serif;
        }
        .bb-player .bb-btn i {
            color: inherit !important;
            font-size: inherit !important;
        }
        .bb-player-buttons {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
        }
        
        .bb-progress-outer {
            width: 100%;
            box-sizing: border-box;
        }
        .bb-progress-wrap {
            width: 100%;
            cursor: pointer;
            padding: 10px 0;
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
        }
        .bb-progress-bar {
            width: 100%;
            height: 6px;
            background: rgba(255,255,255,0.2);
            border-radius: 3px;
            position: relative;
            overflow: visible;
            box-sizing: border-box;
        }
        .bb-progress-fill {
            height: 100%;
            width: 0%;
            border-radius: 3px;
            position: relative;
            transition: width 0.2s linear;
        }
        .bb-progress-fill::after {
            content: '';
            position: absolute;
            right: -2px;
            top: 50%;
            transform: translateY(-50%);
            width: 4px;
            height: 18px;
            border-radius: 2px;
            background: #ffffff;
            box-shadow: 0 0 4px rgba(0,0,0,0.5);
        }
        .bb-time-row {
            display: flex;
            justify-content: space-between;
            width: 100%;
            box-sizing: border-box;
            font-size: 0.8em;
            opacity: 0.85;
            margin-top: 4px;
        }
        
        .bb-tabs {
            display: flex;
            width: 100%;
            box-sizing: border-box;
            border-radius: 0 0 8px 8px;
            overflow: hidden;
        }
        .bb-tab {
            all: unset !important;
            flex: 1 !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 5px !important;
            text-align: center !important;
            padding: 5px 4px !important;
            font-size: 0.68em !important;
            font-family: arial, sans-serif !important;
            cursor: pointer !important;
            box-sizing: border-box !important;
            text-decoration: none !important;
            white-space: nowrap !important;
            transition: background 0.2s, color 0.2s !important;
        }
        .bb-tab:hover {
            filter: none !important;
        }
        .bb-tab + .bb-tab {
            border-left: 1px solid rgba(0,0,0,0.15) !important;
        }
        .bb-tab-download {
            font-style: italic !important;
        }
        
        .bb-tabs-bradcast {
            border: 2px solid #e94560;
            border-top: 1px dashed rgba(0,0,0,0.15);
        }
        .bb-tabs-bradcast a.bb-tab,
        .bb-tabs-bradcast button.bb-tab {
            background: #c8c8d4 !important;
            color: #1a1a2e !important;
        }
        .bb-tabs-bradcast a.bb-tab i,
        .bb-tabs-bradcast button.bb-tab i {
            color: #e94560 !important;
        }
        .bb-tabs-bradcast a.bb-tab:hover,
        .bb-tabs-bradcast button.bb-tab:hover {
            background: #e94560 !important;
            color: #ffffff !important;
        }
        .bb-tabs-bradcast a.bb-tab:hover i,
        .bb-tabs-bradcast button.bb-tab:hover i {
            color: #ffffff !important;
        }
        
        .bb-tabs-gnr {
            border: 2px solid #5ADA04;
            border-top: 1px dashed rgba(0,0,0,0.15);
        }
        .bb-tabs-gnr a.bb-tab,
        .bb-tabs-gnr button.bb-tab {
            background: #FFFF80 !important;
            color: #1a3d1a !important;
        }
        .bb-tabs-gnr a.bb-tab i,
        .bb-tabs-gnr button.bb-tab i {
            color: #098709 !important;
        }
        .bb-tabs-gnr a.bb-tab:hover,
        .bb-tabs-gnr button.bb-tab:hover {
            background: #5ADA04 !important;
            color: #ffffff !important;
        }
        .bb-tabs-gnr a.bb-tab:hover i,
        .bb-tabs-gnr button.bb-tab:hover i {
            color: #ffffff !important;
        }
        
        .bb-tabs-generic {
            border: 2px solid #F5C774;
            border-top: 1px dashed rgba(0,0,0,0.15);
        }
        .bb-tabs-generic a.bb-tab,
        .bb-tabs-generic button.bb-tab {
            background: #F5C774 !important;
            color: #000000 !important;
        }
        .bb-tabs-generic a.bb-tab i,
        .bb-tabs-generic button.bb-tab i {
            color: #000000 !important;
        }
        .bb-tabs-generic a.bb-tab:hover,
        .bb-tabs-generic button.bb-tab:hover {
            background: #F5C774 !important;
            color: #ffffff !important;
        }
        .bb-tabs-generic a.bb-tab:hover i,
        .bb-tabs-generic button.bb-tab:hover i {
            color: #ffffff !important;
        }
        
        @media (max-width: 600px) {
            .bb-player-inner {
                flex-direction: column;
                align-items: stretch;
            }
            .bb-player-col1 {
                flex-direction: row;
                width: 100%;
                text-align: left;
                align-items: flex-start;
            }
            .bb-player-logo {
                width: 60px;
                height: 60px;
                flex-shrink: 0;
            }
            .bb-player-col2 {
                width: 100%;
                min-width: 0;
            }
            .bb-progress-outer,
            .bb-progress-wrap,
            .bb-progress-bar {
                width: 100%;
            }
            .bb-tabs {
                flex-direction: column;
            }
            .bb-tab {
                padding: 8px 4px !important;
                white-space: normal !important;
            }
            .bb-tab + .bb-tab {
                border-left: none !important;
                border-top: 1px solid rgba(0,0,0,0.15) !important;
            }
        }
    </style>
    <script>
    // Actively remove any Google ad node Google injects into the
    // player wrap after page load, in case a new ad format inserts
    // via JS rather than being caught by the CSS rule above.
    (function() {
        var selector = 'ins.adsbygoogle, .adsbygoogle, iframe[id^="aswift_"], iframe[src*="googlesyndication"], iframe[src*="doubleclick"]';
        var observer = new MutationObserver(function(mutations) {
            document.querySelectorAll('.bb-player-wrap').forEach(function(wrap) {
                wrap.querySelectorAll(selector).forEach(function(ad) {
                    ad.remove();
                });
            });
        });
        document.querySelectorAll('.bb-player-wrap').forEach(function(wrap) {
            observer.observe(wrap, { childList: true, subtree: true });
        });
    })();
    function bbTogglePlay(id, btn) {
        var audio = document.getElementById(id);
        if (audio.paused) {
            document.querySelectorAll('audio').forEach(function(a) {
                if (a.id !== id) {
                    a.pause();
                    var ob = a.closest('.bb-player').querySelector('.bb-play');
                    if (ob) {
                        ob.querySelector('.bb-icon-play').style.display = '';
                        ob.querySelector('.bb-icon-pause').style.display = 'none';
                    }
                    var ot = a.closest('.bb-player').querySelector('.bb-episode-title-inner');
                    if (ot) ot.style.animationPlayState = 'paused';
                }
            });
            audio.play();
            btn.querySelector('.bb-icon-play').style.display = 'none';
            btn.querySelector('.bb-icon-pause').style.display = '';
        } else {
            audio.pause();
            btn.querySelector('.bb-icon-play').style.display = '';
            btn.querySelector('.bb-icon-pause').style.display = 'none';
        }
    }
    function bbSkip(id, seconds) {
        var audio = document.getElementById(id);
        audio.currentTime = Math.max(0, audio.currentTime + seconds);
    }
    function bbFormatTime(secs) {
        if (isNaN(secs) || secs === Infinity) return '0:00';
        var m = Math.floor(secs / 60);
        var s = Math.floor(secs % 60);
        return m + ':' + (s < 10 ? '0' : '') + s;
    }
    function bbGetRatio(event, wrap) {
        var rect = wrap.getBoundingClientRect();
        var clientX = event.touches ? event.touches[0].clientX : event.clientX;
        return Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
    }
    function bbUpdateDisplay(ratio, fill, played, left, duration) {
        if (fill)   fill.style.width = (ratio * 100) + '%';
        if (played) played.textContent = bbFormatTime(ratio * duration);
        if (left)   left.textContent   = '-' + bbFormatTime(duration - (ratio * duration));
    }
    function bbCopyToClipboard(text, btn, successMsg) {
        navigator.clipboard.writeText(text).then(function() {
            var orig = btn.innerHTML;
            btn.innerHTML = successMsg;
            setTimeout(function() { btn.innerHTML = orig; }, 2000);
        }).catch(function() {
            var ta = document.createElement('textarea');
            ta.value = text;
            ta.style.cssText = 'position:fixed;opacity:0;';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            var orig = btn.innerHTML;
            btn.innerHTML = successMsg;
            setTimeout(function() { btn.innerHTML = orig; }, 2000);
        });
    }
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('audio[id^="bb-audio-"]').forEach(function(audio) {
            var suffix  = audio.id.replace('bb-audio-', '');
            var fill    = document.getElementById('bb-fill-' + suffix);
            var played  = document.getElementById('bb-played-' + suffix);
            var left    = document.getElementById('bb-left-' + suffix);
            var wrap    = document.getElementById('wrap-bb-audio-' + suffix);
            var player  = audio.closest('.bb-player');
            var titleEl = player ? player.querySelector('.bb-episode-title-inner') : null;
            var isDragging = false;
            if (titleEl) {
                titleEl.style.animation = 'bb-scroll 40s linear infinite';
                titleEl.style.animationPlayState = 'paused';
            }
            audio.addEventListener('play', function() {
                if (titleEl) titleEl.style.animationPlayState = 'running';
            });
            audio.addEventListener('pause', function() {
                if (titleEl) titleEl.style.animationPlayState = 'paused';
            });
            audio.addEventListener('timeupdate', function() {
                if (isDragging || !audio.duration) return;
                var pct = (audio.currentTime / audio.duration) * 100;
                if (fill)   fill.style.width = pct + '%';
                if (played) played.textContent = bbFormatTime(audio.currentTime);
                if (left)   left.textContent   = '-' + bbFormatTime(audio.duration - audio.currentTime);
            });
            audio.addEventListener('ended', function() {
                var btn = player ? player.querySelector('.bb-play') : null;
                if (btn) {
                    btn.querySelector('.bb-icon-play').style.display = '';
                    btn.querySelector('.bb-icon-pause').style.display = 'none';
                }
                if (fill)    fill.style.width = '0%';
                if (played)  played.textContent = '0:00';
                if (left)    left.textContent   = '0:00';
                if (titleEl) titleEl.style.animationPlayState = 'paused';
            });
            if (!wrap) return;
            function onDragStart(e) {
                if (!audio.duration) return;
                isDragging = true;
                e.preventDefault();
                bbUpdateDisplay(bbGetRatio(e, wrap), fill, played, left, audio.duration);
            }
            function onDragMove(e) {
                if (!isDragging || !audio.duration) return;
                e.preventDefault();
                bbUpdateDisplay(bbGetRatio(e, wrap), fill, played, left, audio.duration);
            }
            function onDragEnd(e) {
                if (!isDragging || !audio.duration) return;
                isDragging = false;
                var ratio = bbGetRatio(e, wrap);
                audio.currentTime = ratio * audio.duration;
                bbUpdateDisplay(ratio, fill, played, left, audio.duration);
            }
            wrap.addEventListener('mousedown',  onDragStart);
            document.addEventListener('mousemove', onDragMove);
            document.addEventListener('mouseup',   onDragEnd);
            wrap.addEventListener('touchstart', onDragStart, { passive: false });
            document.addEventListener('touchmove',  onDragMove,  { passive: false });
            document.addEventListener('touchend',   onDragEnd);
        });

        // Wire up "Link to this page" and "Embed on your site!" tab buttons
        document.querySelectorAll('.bb-tabs').forEach(function(tabs) {
            var linkBtn  = tabs.querySelector('.bb-tab:not(.bb-tab-download):not([data-embed])');
            var embedBtn = tabs.querySelector('.bb-tab[data-embed]');
            if (linkBtn) {
                linkBtn.addEventListener('click', function() {
                    bbCopyToClipboard(window.location.href, linkBtn, '<i class="fa-solid fa-check"></i> Copied!');
                });
            }
            if (embedBtn) {
                embedBtn.addEventListener('click', function() {
                    bbCopyToClipboard(embedBtn.getAttribute('data-embed'), embedBtn, '<i class="fa-solid fa-check"></i> Copied!');
                });
            }
        });
    });
    </script>
        <style>
        .bb-sticky-post {
            box-shadow:
                inset 0 0 0 2px rgba(255, 235, 0, 1),
                0 0 8px 3px rgba(255, 235, 0, 0.5) !important;
