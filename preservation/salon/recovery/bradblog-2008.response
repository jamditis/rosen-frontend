        .elementor-menu-toggle {
            background-color: transparent !important;
        }

        
        .bb-hamburger-menu .elementor-menu-toggle {
            padding: 0 10px 0 0 !important;
        }

        
        .bb-hamburger-menu .elementor-menu-toggle.elementor-active svg {
            fill: red !important;
        }

        .elementor-nav-menu .sub-menu {
            top: 0 !important;
            left: 100% !important;
        }

        .sub-menu {
            max-height: 80vh !important;
            overflow-y: auto !important;
        }

        
        .elementor-nav-menu--dropdown .elementor-sub-item {
            padding-left: 35px !important;
        }

        
        .elementor-nav-menu li:hover > a > span[style] {
            color: #ffffff !important;
        }

        
        .elementor-nav-menu li.current-menu-item:hover > a > span[style] {
            color: inherit !important;
        }

        
        .elementor-nav-menu li.current-menu-parent:hover > a > span[style] {
            color: #ffffff !important;
        }

        
        .elementor-nav-menu li:hover > a > span.sub-arrow svg {
            fill: #ffffff !important;
        }

        
        .elementor-nav-menu li a {
            cursor: pointer !important;
        }

        
        .elementor-nav-menu li.current-menu-item a {
            font-weight: bold !important;
        }

        
        .elementor-nav-menu li a span[style],
        .elementor-sub-item i {
            margin-right: 6px;
        }

        
        .elementor-nav-menu a[href="#"]:not([onclick]) {
            cursor: pointer;
        }

        
        .elementor-menu-toggle:not(.elementor-active)::after {
            content: 'MENU';
            display: block;
            font-size: 9px;
            font-weight: bold;
            text-align: center;
            letter-spacing: 1px;
            margin-top: -4px;
            color: inherit;
        }

        
        .elementor-menu-toggle.elementor-active::after {
            content: 'CLOSE';
            display: block;
            font-size: 9px;
            font-weight: bold;
            text-align: center;
            letter-spacing: 1px;
            margin-top: -4px;
            color: inherit;
        }

        
        .elementor-menu-toggle {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
        }

        
        .elementor-menu-toggle:not(.elementor-active)::after {
            color: #333333 !important;
        }

        
        .elementor-menu-toggle.elementor-active::after {
            color: red !important;
        }
		
        
