<script>
document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll('.comment-body').forEach(function(body) {
        const replies = body.querySelectorAll('.reply');
        const edits   = body.querySelectorAll('.bb-inline-edit-link');
        if (replies.length === 0) return;
        const realReply = replies[replies.length - 1];
        replies.forEach((r, i) => {
            if (i < replies.length - 1) r.remove();
        });
        edits.forEach(e => {
            if (!realReply.contains(e)) e.remove();
        });
        const edit = realReply.querySelector('.bb-inline-edit-link');
        if (!edit && edits.length > 0) {
            realReply.prepend(edits[0]);
        }
    });
});
</script>
    <style>
        .bb-comment-toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            margin-bottom: 6px;
        }
        .bb-comment-toolbar button {
            background: #ffffff;
            border: 1px solid #cccccc;
            border-radius: 3px;
            padding: 3px 8px;
            font-size: 13px;
            font-family: Georgia, serif;
            cursor: pointer;
            color: #333333;
            line-height: 1.4;
            outline: none;
        }
        .bb-comment-toolbar button:hover {
            background: #6b3a2a;
            border-color: #6b3a2a;
            color: #ffffff;
        }
        .bb-comment-toolbar button:focus {
            outline: none;
            box-shadow: none;
            border-color: #cccccc;
            background: #ffffff;
        }
        .bb-comment-toolbar button:focus-visible {
            outline: none;
            box-shadow: none;
        }
        .bb-comment-toolbar button.bb-btn-b { font-weight: bold; }
        .bb-comment-toolbar button.bb-btn-i { font-style: italic; }
        .bb-comment-toolbar button.bb-btn-del { text-decoration: line-through; }
    </style>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        window.initBBToolbar = function(textarea) {
            if (!textarea || textarea.dataset.bbToolbar) return;
            textarea.dataset.bbToolbar = '1';

            var toolbar = document.createElement('div');
            toolbar.className = 'bb-comment-toolbar';
            toolbar.innerHTML =
                '<button type="button" class="bb-btn-b"      data-open="<strong>" data-close="</strong>"        title="Bold">b</button>' +
                '<button type="button" class="bb-btn-i"      data-open="<em>"     data-close="</em>"            title="Italic">i</button>' +
                '<button type="button" class="bb-btn-del"    data-open="<del>"    data-close="</del>"            title="Strikethrough">del</button>' +
                '<button type="button" class="bb-btn-link"                                                       title="Link">link</button>' +
                '<button type="button" class="bb-btn-bquote" data-open="<blockquote>" data-close="</blockquote>" title="Blockquote">b-quote</button>';

            toolbar.querySelectorAll('button').forEach(function(b) {
                b.setAttribute('tabindex', '-1');
            });

            textarea.parentNode.insertBefore(toolbar, textarea);

            toolbar.addEventListener('click', function(e) {
                var btn = e.target.closest('button');
                if (!btn) return;

                var start    = textarea.selectionStart;
                var end      = textarea.selectionEnd;
                var selected = textarea.value.substring(start, end);

                if (btn.classList.contains('bb-btn-link')) {
                    var url = prompt('Enter the URL:');
                    if (!url) return;
                    var replacement = '<a href="' + url + '">' + (selected || 'link text') + '</a>';
                    textarea.value = textarea.value.substring(0, start) + replacement + textarea.value.substring(end);
                    textarea.selectionStart = start;
                    textarea.selectionEnd   = start + replacement.length;
                } else {
                    var open  = btn.getAttribute('data-open');
                    var close = btn.getAttribute('data-close');
                    var replacement = open + selected + close;
                    textarea.value = textarea.value.substring(0, start) + replacement + textarea.value.substring(end);
                    textarea.selectionStart = start + open.length;
                    textarea.selectionEnd   = start + open.length + selected.length;
                }
                textarea.focus();
            });
        }

        // Init on page load
        window.initBBToolbar(document.getElementById('comment'));

		// Keyboard shortcuts: Ctrl+B = bold, Ctrl+I = italic, Ctrl+K = link
        var commentBox = document.getElementById('comment');
        if (commentBox) {
            commentBox.addEventListener('keydown', function(e) {
                if (!e.ctrlKey && !e.metaKey) return;

                if (e.key === 'k' || e.key === 'K') {
                    e.preventDefault();
                    var url = prompt('Enter the URL:');
                    if (!url) return;
                    var start = this.selectionStart;
                    var end   = this.selectionEnd;
                    var selected = this.value.substring(start, end);
                    var replacement = '<a href="' + url + '">' + (selected || 'link text') + '</a>';
                    this.value = this.value.substring(0, start) + replacement + this.value.substring(end);
                    this.selectionStart = start;
                    this.selectionEnd   = start + replacement.length;
                    return;
                }

                var tag = null;
                if (e.key === 'b' || e.key === 'B') tag = 'strong';
                if (e.key === 'i' || e.key === 'I') tag = 'em';
                if (!tag) return;
                e.preventDefault();
                var start = this.selectionStart;
                var end = this.selectionEnd;
                var selected = this.value.substring(start, end);
                var open = '<' + tag + '>';
                var close = '</' + tag + '>';
                var replacement = selected.length
                    ? open + selected + close
                    : open + close;
                this.value = this.value.substring(0, start) + replacement + this.value.substring(end);
                var cursor = selected.length
                    ? start + replacement.length
                    : start + open.length;
                this.setSelectionRange(cursor, cursor);
            });
        }
    });
    </script>
        <script>
    window.addEventListener('load', function() {
        function handleReplyClick(e) {
            if (!e.target.classList.contains('comment-reply-link')) return;
            // Hide #reply-title IMMEDIATELY to prevent FOUC
            var replyTitle = document.getElementById('reply-title');
            if (replyTitle) replyTitle.style.setProperty('display', 'none', 'important');

            // Poll for WordPress's own moveForm() to finish updating
            // #reply-title's text (it can take longer than a fixed
            // delay on some page loads) before reading the name and
            // repositioning our notice.
            var attempts = 0;
            function waitForReplyTitle() {
                attempts++;
                var replyTitle = document.getElementById('reply-title');
                var rawText = replyTitle ? replyTitle.textContent.replace('Cancel reply', '').replace('Reply to', '').trim() : '';
                if (rawText || attempts > 25) {
                    finishReplyNotice(rawText);
                } else {
                    setTimeout(waitForReplyTitle, 20);
                }
            }
            function finishReplyNotice(name) {
                var existing = document.getElementById('bb-reply-notice');
                if (existing) existing.remove();
                var notice = document.createElement('p');
                notice.id = 'bb-reply-notice';
                notice.style.cssText = 'font-style:italic; color:#555; margin-bottom:8px; font-size:1em; font-family:Georgia,serif; font-weight:normal; line-height:1.4;';
                notice.innerHTML = 'Replying to <strong>' + name + '</strong> &mdash; <a href="#" id="bb-cancel-reply" style="color:#990000; font-style:normal; font-weight:normal;">Cancel reply</a>';
                var respond = document.getElementById('respond');
                if (respond) respond.insertBefore(notice, respond.firstChild);
                var ta = document.getElementById('comment');
                if (ta) ta.focus();
                var submitBtn = document.getElementById('submit');
                if (submitBtn) submitBtn.value = 'Post Reply';
                document.getElementById('bb-cancel-reply').addEventListener('click', function(e) {
                    e.preventDefault();
                    var wpCancel = document.getElementById('cancel-comment-reply-link');
                    if (wpCancel) wpCancel.click();
                    notice.remove();
                    if (submitBtn) submitBtn.value = 'Post Comment';
                    setTimeout(function() {
                        var replyTitle = document.getElementById('reply-title');
                        if (replyTitle) {
                            replyTitle.style.setProperty('display', 'block', 'important');
                        }
                    }, 100);
                });
            }
            waitForReplyTitle();
        }
        document.addEventListener('click', handleReplyClick);
        document.addEventListener('touchstart', handleReplyClick);
        // Disable submit button + comment textarea, show "Posting..." on
        // comment submit, so there's visible feedback during the
        // (sometimes slow) POST, prevents accidental duplicate
        // submissions from a second click, and stops the textarea from
        // being edited while the original text is still being posted.
        var commentForm = document.getElementById('commentform');
        if (commentForm) {
            commentForm.addEventListener('submit', function() {
                var btn = document.getElementById('submit');
                if (btn && !btn.disabled) {
                    btn.dataset.origValue = btn.value;
                    btn.disabled = true;
                    btn.style.opacity = '0.6';
                    btn.style.cursor = 'not-allowed';
                    var dotStates = ['Posting.', 'Posting..', 'Posting...'];
                    var dotIndex = 0;
                    btn.value = dotStates[0];
                    var postingInterval = setInterval(function() {
                        dotIndex = (dotIndex + 1) % dotStates.length;
                        btn.value = dotStates[dotIndex];
                    }, 400);
                }
                var ta = document.getElementById('comment');
                if (ta && !ta.readOnly) {
                    ta.readOnly = true;
                    ta.style.opacity = '0.6';
                }
            });
        }
    });
    </script>
        <script>
    window.addEventListener('load', function() {
		

        // Empty search protection + spinner for bb-search widget
		document.querySelectorAll('.bb-search .e-search-form').forEach(function(form) {
            form.addEventListener('submit', function(e) {
                var input = form.querySelector('input.e-search-input');
                if (!input || !input.value.trim()) {
                    e.preventDefault();
                    input.focus();
                    return;
                }
                var btn = form.querySelector('.e-search-submit');
                if (btn) {
                    btn.innerHTML = '<span class="bb-spinner"></span>';
                    btn.disabled = true;
                    // Re-enable button if page load is stopped or interrupted
                    document.addEventListener('readystatechange', function() {
                        if (document.readyState === 'complete') {
                            btn.innerHTML = '<i class="fa-solid fa-magnifying-glass"></i>';
                            btn.disabled = false;
                        }
                    });
                    // Reset spinner if user clicks the clear button
                    var clearBtn = form.querySelector('.e-fas-times');
                    if (clearBtn) {
                        clearBtn.addEventListener('click', function() {
                            btn.innerHTML = '<i class="fa-solid fa-magnifying-glass"></i>';
                            btn.disabled = false;
                        });
                    }
                }
            });
        });

        // Retain search term + show clear button on results pages
        var searchInput = document.querySelector('.bb-search input.e-search-input');
        if (searchInput) {
            var params = new URLSearchParams(window.location.search);
            var term = params.get('s');
            if (term) {
                searchInput.value = term;
                searchInput.dispatchEvent(new Event('input', { bubbles: true }));
            }
        }

		// ⚠️ FRAGILE ANCHOR WARNING — the two marker comments below
		// (BB-STRIP-COMMENT-START / BB-STRIP-COMMENT-END) are exact-text
		// anchors used by a SEPARATE snippet, BB Strip CSS/JS Remark
		// Output, which strips everything between them from what visitors
		// see in View Source. Editing the WORDING of the comment block
		// between the two markers is completely safe. Do NOT remove or
		// rename the two marker lines themselves, or that other snippet's
		// matching rule will silently stop working.
		var mobileSearchIcon = document.querySelector('.bb-mobile-search-icon');
        var searchWidget = document.querySelector('.bb-search');
        if (mobileSearchIcon && searchWidget) {
            var row2Container = searchWidget.parentNode;
            var row2NextSibling = searchWidget.nextSibling;

            function findTemplateRootClass(el) {
                var node = el;
                while (node && node !== document.body) {
                    for (var i = 0; i < node.classList.length; i++) {
                        if (/^elementor-\d+$/.test(node.classList[i])) {
                            return node.classList[i];
                        }
                    }
                    node = node.parentElement;
                }
                return null;
            }
            var templateRootClass = findTemplateRootClass(searchWidget);
            var searchWrapper = document.createElement('div');
            if (templateRootClass) searchWrapper.className = templateRootClass;
            document.body.appendChild(searchWrapper);

            function findHeaderEl() {
                return document.querySelector('.bb-header-bar');
            }

            function positionSearchWidget() {
                if (window.innerWidth > 767) return;
                var headerEl = findHeaderEl();
                var headerRect = headerEl.getBoundingClientRect();
                searchWidget.style.top = headerRect.bottom + 'px';
            }

			mobileSearchIcon.addEventListener('touchend', function(e) {
				e.preventDefault();
				e.stopPropagation();
				var isOpen = window.getComputedStyle(searchWidget).visibility === 'visible';
				if (!isOpen) {
					// Only focus when OPENING, not closing
					var input = searchWidget.querySelector('input.e-search-input');
					if (input) input.focus();
				}
				// 300ms delay matches the hamburger menu's own delay and is required for
				// Elementor's sticky-header JS to recalculate correctly on iOS before
				// the search bar opens.
				setTimeout(function() {
					mobileSearchIcon.click();
				}, 300);
			});
			
            mobileSearchIcon.addEventListener('click', function(e) {
                e.preventDefault();				
                var isOpen = window.getComputedStyle(searchWidget).visibility === 'visible';
				if (!isOpen) {
					searchWrapper.appendChild(searchWidget);
					searchWidget.style.visibility = 'visible';
					if (window.innerWidth <= 767) {
						searchWidget.style.position = 'fixed';
						searchWidget.style.setProperty('width', '100vw', 'important');
						searchWidget.style.setProperty('max-width', '100vw', 'important');
						searchWidget.style.setProperty('left', '0', 'important');
						searchWidget.style.zIndex = '99999';
						searchWidget.style.padding = '10px 15px';
						searchWidget.style.boxShadow = '0 4px 8px rgba(0,0,0,0.2)';
						findHeaderEl().classList.add('bb-header-elevated');
						mobileSearchIcon.style.opacity = '0.4';
						positionSearchWidget();
						window.addEventListener('scroll', positionSearchWidget, { passive: true });
						window.addEventListener('resize', positionSearchWidget);
					}
                    var input = searchWidget.querySelector('input.e-search-input');
                    if (input) input.focus();
					
					var input = searchWidget.querySelector('input.e-search-input');
                    if (input) {
                        input.focus();
                        input.addEventListener('focus', function() {
                            setTimeout(function() {
                                window.scrollBy(0, 0);
                            }, 300);
                        }, { once: true });
                    }
					
                } else {
                    searchWidget.style.visibility = 'hidden';
                    searchWidget.style.position = 'absolute';
                    searchWidget.style.top = '';
                    searchWidget.style.removeProperty('left');
                    searchWidget.style.removeProperty('width');
                    searchWidget.style.removeProperty('max-width');
                    searchWidget.style.zIndex = '';
                    searchWidget.style.padding = '';
                    searchWidget.style.boxShadow = '';
                    findHeaderEl().classList.remove('bb-header-elevated');
                    mobileSearchIcon.style.opacity = '1';
                    window.removeEventListener('scroll', positionSearchWidget);
                    window.removeEventListener('resize', positionSearchWidget);
                    if (row2NextSibling) {
                        row2Container.insertBefore(searchWidget, row2NextSibling);
                    } else {
                        row2Container.appendChild(searchWidget);
                    }
                }
            });
        }

    });
    </script>
        <script>
    window.addEventListener('load', function() {
        // Search trigger
        document.querySelectorAll('.elementor-nav-menu a').forEach(function(link) {
            if (link.textContent.trim().toLowerCase().includes('search')) {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    var isMobile = window.innerWidth < 768;
                    var delay = isMobile ? 300 : 0;
					setTimeout(function() {
						if (isMobile) {
							var mobileIcon = document.querySelector('.bb-mobile-search-icon');
							if (mobileIcon) mobileIcon.click();
						} else {
							var searchInput = document.querySelector('.bb-search input.e-search-input');
							if (searchInput) searchInput.focus();
						}
					}, delay);
                });
            }
        });
        // Hover-to-open on desktop only
        if (window.innerWidth > 1024) {
            var toggle = document.querySelector('.elementor-menu-toggle');
            var nav = document.querySelector('.elementor-nav-menu--dropdown');
            if (toggle && nav) {
                var wrapper = toggle.closest('.elementor-widget-nav-menu');
                wrapper.addEventListener('mouseenter', function() {
                    if (!toggle.classList.contains('elementor-active')) {
                        toggle.click();
                    }
                });
                wrapper.addEventListener('mouseleave', function() {
                    if (toggle.classList.contains('elementor-active')) {
                        toggle.click();
                    }
                });
            }
        }
    });
    </script>
        <script>
    document.addEventListener('DOMContentLoaded', function() {

        // Find the main loop by its CSS class
        var mainLoop = document.querySelector('.bb-main-loop');
        if ( ! mainLoop ) return;

        // Find the pagination nav inside the main loop
        var pagination = mainLoop.querySelector('.elementor-pagination');
        if ( ! pagination ) return;

        // Hide jump box if no ellipsis present — all pages already visible
        var hasDots = pagination.querySelector('.page-numbers.dots');
        if ( ! hasDots ) return;

        // Detect the Elementor pagination parameter dynamically
        var paramKey = null;
        var links = pagination.querySelectorAll('a.page-numbers');
        for ( var i = 0; i < links.length; i++ ) {
            var href = links[i].href;
            var match = href.match(/[?&](e-page-[a-z0-9]+)=/);
            if ( match ) {
                paramKey = match[1];
                break;
            }
        }
        if ( ! paramKey ) return;

        // Get max page from Elementor's data attribute on the loop container
        var loopContainer = mainLoop.querySelector('[data-max-page]');
        var maxPage = loopContainer ? parseInt( loopContainer.getAttribute('data-max-page') ) : null;

        // Build the jump box
        var wrapper = document.createElement('div');
        wrapper.className = 'bb-jump-to-page';

        var button = document.createElement('button');
        button.textContent = 'Go to page:';
        button.disabled = true;
        button.className = 'bb-jump-button bb-jump-disabled';

        var input = document.createElement('input');
        input.type = 'number';
        input.id = 'bb-jump-input';
        input.min = 1;
        if ( maxPage ) input.max = maxPage;

        function doJump() {
            var page = parseInt( input.value );
            if ( ! page || page < 1 ) return;
            if ( maxPage && page > maxPage ) page = maxPage;

            var url = new URL( window.location.href );
            if ( page === 1 ) {
                url.searchParams.delete( paramKey );
            } else {
                url.searchParams.set( paramKey, page );
            }
            window.location.href = url.toString();
        }

        // Enable/disable button based on whether input has a value
        input.addEventListener( 'input', function() {
            var hasValue = input.value.trim() !== '';
            button.disabled = ! hasValue;
            button.className = hasValue ? 'bb-jump-button bb-jump-active' : 'bb-jump-button bb-jump-disabled';
        });

        button.addEventListener( 'click', doJump );
        input.addEventListener( 'keydown', function(e) {
            if ( e.key === 'Enter' && ! button.disabled ) doJump();
        });

        wrapper.appendChild( button );
        wrapper.appendChild( input );
        pagination.parentNode.insertBefore( wrapper, pagination.nextSibling );

        // Shrink pagination buttons ONLY when they overflow the container.
        // Only rechecks on actual width changes — ignores iOS Safari
        // address bar show/hide which fires resize on height changes only.
        function checkPaginationOverflow() {
            if ( pagination.scrollWidth > pagination.offsetWidth ) {
                pagination.classList.add( 'bb-pagination-compact' );
            } else {
                pagination.classList.remove( 'bb-pagination-compact' );
            }
        }
		// Delay initial check slightly to allow Elementor to finish
		// rendering pagination before measuring overflow
		setTimeout( function() {
			checkPaginationOverflow();
		}, 300 );

		var lastWidth = window.innerWidth;
        window.addEventListener( 'resize', function() {
            if ( window.innerWidth !== lastWidth ) {
                lastWidth = window.innerWidth;
                checkPaginationOverflow();
            }
        });

    });
    </script>

    <style>
    

    
	.bb-main-loop .elementor-pagination {
		margin-bottom: 40px;
	}
	.bb-jump-to-page {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		margin-top: -22px;
		margin-bottom: 40px;
        font-family: 'Libre Franklin', sans-serif;
        font-size: 14px;
        color: #000000;
    }

    
    .bb-jump-to-page input::-webkit-outer-spin-button,
    .bb-jump-to-page input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    .bb-jump-to-page input[type=number] {
        -moz-appearance: textfield;
    }
    .bb-jump-to-page input {
        width: 60px;
        padding: 6px 8px;
        border: 1px solid #cccccc;
        border-radius: 4px;
        font-size: 14px;
        font-family: 'Libre Franklin', sans-serif;
        text-align: center;
    }

    
    .bb-jump-button {
        padding: 6px 14px;
        border: 1px solid #cccccc;
        border-radius: 4px;
        font-size: 14px;
        font-family: 'Libre Franklin', sans-serif;
        cursor: default;
    }
    .bb-jump-button.bb-jump-disabled {
        background: #f0f0f0;
        color: #999999;
        border-color: #cccccc;
        cursor: default;
    }
    
    .bb-jump-button.bb-jump-active {
        background: #990000;
        color: #ffffff;
        border-color: #990000;
        cursor: pointer;
    }
    .bb-jump-button.bb-jump-active:hover {
        background: #770000;
    }

    
		.elementor-pagination.bb-pagination-compact {
			gap: 4px !important;
		}
		.elementor-pagination.bb-pagination-compact .page-numbers {
			min-width: 32px !important;
			height: 34px !important;
			padding: 0 8px !important;
			font-size: 13px !important;
		}
		.elementor-pagination.bb-pagination-compact .page-numbers.prev,
		.elementor-pagination.bb-pagination-compact .page-numbers.next {
			padding: 0 10px !important;
		}
		.elementor-pagination.bb-pagination-compact .page-numbers.dots {
			min-width: 20px !important;
			padding: 0 4px !important;
		}
    </style>
    			<script>
				( () => {
					const lazyloadRunObserver = () => {
						const lazyloadBackgrounds = document.querySelectorAll( `.e-con.e-parent:not(.e-lazyloaded)` );
						const lazyloadBackgroundObserver = new IntersectionObserver( ( entries ) => {
							entries.forEach( ( entry ) => {
								if ( entry.isIntersecting ) {
									let lazyloadBackground = entry.target;
									if( lazyloadBackground ) {
										lazyloadBackground.classList.add( 'e-lazyloaded' );
									}
									lazyloadBackgroundObserver.unobserve( entry.target );
								}
							});
						}, { rootMargin: '200px 0px 200px 0px' } );
						lazyloadBackgrounds.forEach( ( lazyloadBackground ) => {
							lazyloadBackgroundObserver.observe( lazyloadBackground );
						} );
					};
					const events = [
						'DOMContentLoaded',
						'elementor/lazyload/observe',
					];
					events.forEach( ( event ) => {
						document.addEventListener( event, lazyloadRunObserver );
					} );
				} )();
			</script>
