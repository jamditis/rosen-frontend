    <style>
	
	li.comments-closed .reply .wpulike .wp_ulike_btn {
		opacity: 0.35;
		pointer-events: none;
		cursor: default;
	}
	
	
	.reply .wpulike {
		order: 2;
		margin-left: 12px;
		padding-left: 2px;
		position: relative;
	}
	.reply .wpulike::before {
		content: "";
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
		width: 1px;
		height: 20px;
		background: rgba(0,0,0,0.15);
	}
	.reply .bb-inline-edit-link {
		order: 3;
		margin-left: auto !important;
	}
		
	.reply .wpulike .wp_ulike_btn {
		background: transparent !important;
		box-shadow: none !important;
	}
	.reply .wpulike .count-box {
		margin-left: -6px !important;
	}
	
	.reply {
		justify-content: flex-start !important;
	}
		
	
	li.comments-closed .reply .wpulike::before {
		display: none !important;
	}
	li.comments-closed .reply .wpulike {
		margin-left: 0 !important;
		padding-left: 0 !important;
	}
		
    </style>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.wpulike').forEach(function(ulikeEl) {
            var article = ulikeEl.closest('article');
            if (!article) return;
            var replyDiv = article.querySelector('.reply');
            if (!replyDiv) return;
            var editLink = replyDiv.querySelector('.bb-inline-edit-link');
            if (editLink) {
                replyDiv.insertBefore(ulikeEl, editLink);
            } else {
                replyDiv.appendChild(ulikeEl);
            }
        });
    });
    </script>
