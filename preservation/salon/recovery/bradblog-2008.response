<script>
(function(){
    var cards = document.querySelectorAll('.bb-main-loop .bb-type-quicklink .bb25-archive-posts-loop-items');
    if (!cards.length) return;
    var bolt = '<svg viewBox="0 0 10 20" preserveAspectRatio="none" aria-hidden="true"><path d="M6.5 0 0 11h4L2.5 20 10 8H6z"/></svg>';
    var tipHtml = 'QuickLink! Some stuff you might want to know about. (<i>Links open in separate window</i>.)';
    var timer;
    function closeAll(){
        document.querySelectorAll('.bb-ql-bolt.bb-tip-open').forEach(function(b){ b.classList.remove('bb-tip-open'); });
    }
    cards.forEach(function(card){
        if (card.querySelector('.bb-ql-bolt')) return;
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'bb-ql-bolt';
        b.setAttribute('aria-label', 'What is a Quicklink?');
        b.innerHTML = bolt + '<span class="bb-ql-tip">' + tipHtml + '</span>';
        b.addEventListener('click', function(e){
            e.preventDefault();
            e.stopPropagation();
            var wasOpen = b.classList.contains('bb-tip-open');
            closeAll();
            clearTimeout(timer);
            if (!wasOpen) {
                b.classList.add('bb-tip-open');
                timer = setTimeout(closeAll, 4000);
            }
        });
        card.appendChild(b);
    });
    document.addEventListener('click', closeAll);
})();
</script>

