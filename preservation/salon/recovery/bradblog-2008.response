<style>
	
	#comments .comment .comment-body,
	#comments .pingback .comment-body {
		padding-inline-start: 0 !important;
		padding-block-start: 0 !important;
		padding-block-end: 0 !important;
		display: block !important;
	}

	.comment-author {
		display:flex !important;
		align-items:center !important;
		gap:0.5em !important;
		min-height:40px !important;
	}

	.comment-author .fn,
	.comment-author .says {
		display:none!important;
	}

	.comment-metadata,
	.comment-meta {
		display:none!important;
	}

	.brad-comment-grid {
		display: grid !important;
		grid-template-columns: 48px auto 1fr !important;
		column-gap: 12px !important;
		align-items: start !important;
		margin-bottom: 0 !important;
	}

	.brad-comment-grid.brad-no-number {
		grid-template-columns: 48px 1fr !important;
	}

	.brad-avatar img {
		display: block !important;
		width: 48px !important;
		height: 48px !important;
		border-radius: 50% !important;
		object-fit: cover !important;
	}

	.brad-number {
		font-family:sans-serif!important;
		font-size:1.15em!important;
		font-weight:normal!important;
		line-height:1.3!important;
		padding:0!important;
	}

	
	.brad-comment-body,
	.brad-comment-body a {
		overflow-wrap: break-word;
		word-break: break-word;
	}

	.brad-comment-body {
		display:block;
	}

	.brad-new-header {
		font-family:sans-serif!important;
		font-size:1.15em!important;
		line-height:1.3!important;
		margin-bottom:0!important;
		vertical-align:middle!important;
	}

	.brad-new-header .author {
		font-weight:700!important;
	}

	.brad-new-header .brad-permalink {
		font-size:0.6em!important;
		vertical-align:middle!important;
	}
	
	.brad-reply-to {
		font-family: sans-serif !important;
		font-size: 0.8em !important;
		color: #666 !important;
		margin-bottom: 1.6em !important;
	}
	

	.comment-edit-link {
		display: inline !important;
		margin: 0 !important;
		padding: 0 !important;
		float: none !important;
		clear: none !important;
	}

	
	.brad-comment-body > *:last-child {
		margin-bottom: 0 !important;
	}

	.reply {
		display: flex !important;
		justify-content: space-between !important;
		align-items: center !important;
		margin-left: calc(48px + 12px) !important;
		width: calc(100% - 60px) !important;
		box-sizing: border-box !important;
		margin-top: 0em !important;
		margin-bottom: 1.5em !important;
	}

	 
	
	.reply .comment-reply-link::before {
		content: none;
	}

	.reply .comment-reply-link::after {
		font-family: "Font Awesome 6 Free";
		font-weight: 900;
		content: '\00a0\f148';
	}

	.reply a:not(.bb-inline-edit-link) {
		margin-left: 0 !important;
		order: 1 !important;
	}

	.reply .bb-inline-edit-link {
		margin-left: auto !important;
		order: 2 !important;
		font-weight: normal !important;
		color: #00cc00 !important;
		font-style: italic !important;
	}
	
	.comment-content .reply {
		margin-top: 0.75em !important;
		font-family: "Libre Franklin", sans-serif !important;
		font-size: 11px !important;
		line-height: 1 !important;
	}
	
	.comment-content .reply .count-box {
		font-weight: bold !important;
	}
	
	.bb-reply-disabled {
		color: #999 !important;
		cursor: default !important;
		pointer-events: none !important;
	}

	
	.comment-form p {
		margin-bottom: 8px !important;
	}
	.comment-notes {
		font-size: 14px !important;
		font-weight: normal !important;
		font-family: Georgia, serif !important;
		margin-bottom: 16px !important;
		display: block !important;
	}
	#email-notes,
	.required-field-message {
		font-size: 14px !important;
		font-weight: normal !important;
	}
	.comment-form-author input,
	.comment-form-email input,
	.comment-form-url input,
	.comment-form-comment textarea {
		width: 100% !important;
		padding: 6px 8px !important;
		font-size: 14px !important;
		box-sizing: border-box !important;
	}
	.comment-form label {
		font-size: 14px !important;
		font-weight: bold !important;
		margin-bottom: 2px !important;
		display: block !important;
	}
	.comment-form-cookies-consent {
		display: flex !important;
		align-items: center !important;
		gap: 8px !important;
		margin-top: 24px !important;
		margin-bottom: 24px !important;
	}
	.comment-form-cookies-consent input[type="checkbox"] {
		margin: 0 !important;
		flex-shrink: 0 !important;
	}
	.comment-form-cookies-consent label {
		display: inline !important;
		margin: 0 !important;
	}
	.form-submit {
		margin-top: 12px !important;
	}

	
	.form-submit input[type="submit"] {
		margin-bottom: 20px !important;
	}

	
	#cancel-comment-reply-link {
		display: inline-block !important;
		margin-left: 16px !important;
		font-size: 0.6em !important;
		font-style: italic !important;
		color: #990000 !important;
		vertical-align: middle !important;
	}

	
	#reply-title {
		font-size: 1.2em !important;
		line-height: 1.4 !important;
	}
	#reply-title small {
		display: none !important;
	}


	#comments .children {
		border-inline-start: 0 !important;
	}
	#comments ol.comment-list .children::before {
		content: "" !important;
		display: none !important;
	}
	#comments .comment .comment-body,
	#comments .pingback .comment-body {
		border-block-end-color: transparent !important;
		background-image: linear-gradient(to right, transparent 60px, #ccc 60px, #ccc 100%, transparent 100%);
		background-repeat: no-repeat;
		background-position: left bottom 10px;
		background-size: 100% 1px;
	}

</style>

