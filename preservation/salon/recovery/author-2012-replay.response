                </span>
                    </a>
                </li>
        <!--
        <li>
                    <a
            data-service="reddit"
                        href="http://www.salon.com/2006/04/20/mclellan_2/"
            data-share-url="http://www.salon.com/2006/04/20/mclellan_2/"
            data-headline="Nullifying the press"
            data-thumbnail="http://media.salon.com/2006/04/nullifying_the_press-300x200.jpg"
            class="shareButton reddit"
         >
            <span class="shareButtonBox">
                <span class="shareIcon"></span>
            </span>
                    </a>
                </li>
        <li>
                    <a
