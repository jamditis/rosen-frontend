{
  // Codespaces / dev-container for the rosen-archive maintenance work that does
  // not fit a headless Action: the interactive entity-extraction Ralph Loop,
  // hand-tuned enrichment passes, and "the Action is broken, push the JSON by
  // hand" break-glass moments. Design:
  // docs/plans/2026-05-29-batch-maintenance-runner-design.md
  //
  // The Codespace follows the repo (it transfers to Jay/Hali with ownership),
  // unlike Google Cloud Shell whose $HOME dies with a personal Google account.
  // See docs/setup/maintenance-runbook.md for which job to run when.
  "name": "rosen-archive maintenance",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Install the same toolchain the Actions use: Poetry + backend deps (with the
  // dev group for the test suite), the Playwright Chromium the scraper needs,
  // and the root npm deps for `node data/export-archive-data.js` + `npm test`.
  "postCreateCommand": "pipx install poetry && poetry -C backend install --with dev && poetry -C backend run playwright install --with-deps chromium && npm ci",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  },

  // The maintenance jobs need a service-account key and a Gemini key at runtime.
  // In a Codespace, set these as Codespaces secrets (Settings -> Codespaces) so
  // they arrive as env vars; the scripts read them via rosen_scraper.sheets_client
  // exactly as the Action does. Listed here as documentation, not as a contract.
  "remoteEnv": {
    "SPREADSHEET_NAME": "${localEnv:SPREADSHEET_NAME}",
    "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}",
    "ROSEN_SHEETS_SA_KEY_JSON": "${localEnv:ROSEN_SHEETS_SA_KEY_JSON}"
  }
}
